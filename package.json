{
  "name": "scrypted-camera-api",
  "version": "0.0.1",
  "description": "Scrypted plugin exposing a low-latency REST API for camera snapshots, NVR clip retrieval, recording thumbnails, and frame extraction",
  "keywords": [
    "scrypted",
    "camera",
    "api",
    "nvr",
    "snapshot",
    "video-clips",
    "frame-extraction",
    "low-latency"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "scrypted-webpack",
    "prepublishOnly": "scrypted-setup-project",
    "scrypted-deploy": "scrypted-deploy",
    "scrypted-debug": "scrypted-debug",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "scrypted": {
    "name": "Camera API",
    "type": "API",
    "interfaces": [
      "HttpRequestHandler",
      "Settings"
    ]
  },
  "dependencies": {
    "@scrypted/sdk": "latest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
